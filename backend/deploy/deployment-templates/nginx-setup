#!/bin/bash

# ============================================================================
# Nginx HTTP-Setup Template
# Creates HTTP-only nginx configuration for Let's Encrypt certificate requests
# ============================================================================

setup_nginx_http() {
    local ENV_TYPE="$1"
    local DOMAIN="$2"

    echo "Setting up Nginx HTTP configuration for $ENV_TYPE environment..."

    # Ensure nginx is installed
    if ! command -v nginx >/dev/null 2>&1; then
        echo "Installing nginx..."
        apt-get update && apt-get install -y nginx
    fi

    # Ensure certbot is installed (needed for webroot)
    if ! command -v certbot >/dev/null 2>&1; then
        echo "Installing certbot..."
        apt-get update && apt-get install -y certbot python3-certbot-nginx
    fi

    # Create webroot directory for ACME challenges
    echo "Setting up webroot directory..."
    mkdir -p /var/www/certbot/.well-known/acme-challenge
    chown -R www-data:www-data /var/www/certbot
    chmod -R 755 /var/www/certbot

    # Determine server_name based on environment
    local server_name
    if [ "$ENV_TYPE" = "prod" ]; then
        server_name="$DOMAIN www.$DOMAIN"
    else
        server_name="$DOMAIN"
    fi

    # Create nginx configuration
    cat > "/etc/nginx/sites-available/lets-todo-$ENV_TYPE" << EOF
# HTTP Server - ACME Challenge + HTTPS Redirect
server {
    listen 80;
    listen [::]:80;
    server_name $server_name;

    # ACME Challenge for certbot
    location /.well-known/acme-challenge/ {
        alias /var/www/certbot/.well-known/acme-challenge/;
        try_files \$uri =404;
    }

    # All other requests - Temporary status page (will be updated after SSL setup)
    location / {
        return 200 "SSL setup in progress for $ENV_TYPE environment...";
        add_header Content-Type text/plain;
    }
}
EOF

    # Enable site
    ln -sf "/etc/nginx/sites-available/lets-todo-$ENV_TYPE" "/etc/nginx/sites-enabled/"

    # Test and reload nginx
    nginx -t
    systemctl reload nginx

    echo "Nginx HTTP configuration for $ENV_TYPE created and enabled"
}
