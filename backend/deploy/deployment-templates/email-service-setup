#!/bin/bash

# ============================================================================
# Email Service Setup Template
# Configures email service for password reset functionality
# ============================================================================

setup_email_service() {
    local ENV_TYPE="$1"
    local DOMAIN="$2"
    local PORT="$3"
    local PROJECT_DIR="$4"

    echo "Setting up email service for $ENV_TYPE environment..."

    cd "$PROJECT_DIR"

    # Check if services directory exists in the target project directory
    if [ ! -d "services" ]; then
        echo "Services directory not found in $PROJECT_DIR"
        echo "This indicates the project files copy step may have failed"
        return 1
    fi

    # Check if emailService.js exists
    if [ ! -f "services/emailService.js" ]; then
        echo "emailService.js not found in services directory"
        return 1
    fi

    # Verify nodemailer dependency is installed
    echo "Verifying nodemailer dependency..."
    if ! npm list nodemailer &>/dev/null; then
        echo " nodemailer not found, installing..."
        npm install nodemailer --save

        if [ $? -eq 0 ]; then
            echo "nodemailer installed successfully"
        else
            echo "Failed to install nodemailer"
            return 1
        fi
    else
        echo "nodemailer already installed"
    fi

    # Map environment type for config file (feat -> feature, stage -> staging)
    local CONFIG_ENV="$ENV_TYPE"
    case "$ENV_TYPE" in
        "feat") CONFIG_ENV="feature" ;;
        "stage") CONFIG_ENV="staging" ;;
        "prod") CONFIG_ENV="production" ;;
    esac

    # Check email configuration in environment file
    local ENV_FILE="config/env/.env.$CONFIG_ENV"

    if [ -f "$ENV_FILE" ]; then
        echo "Checking email configuration in $ENV_FILE..."

        # Check if email provider is configured
        if grep -q "EMAIL_PROVIDER=" "$ENV_FILE" && grep -q "EMAIL_USER=" "$ENV_FILE"; then
            echo "Email configuration found in environment file"

            # Extract email provider for logging
            EMAIL_PROVIDER=$(grep "EMAIL_PROVIDER=" "$ENV_FILE" | cut -d'=' -f2)
            if [ -n "$EMAIL_PROVIDER" ]; then
                echo "Email provider configured: $EMAIL_PROVIDER"
            else
                echo "ℹ Email provider not set (development mode - console output)"
            fi
        else
            echo " Email configuration not found in $ENV_FILE"
            echo "Email service will run in development mode (console output)"
        fi
    else
        echo "Environment file $ENV_FILE not found"
        return 1
    fi

    # Test email service initialization (dry run)
    echo "Testing email service initialization..."

    # Create a simple test script to verify the email service loads correctly
    cat > /tmp/test_email_service.js << 'EOF'
import { emailService } from './services/emailService.js';

console.log('Email service loaded successfully');

// Test connection if transporter exists
emailService.testConnection().then(result => {
    if (result.success) {
        console.log('Email connection test successful:', result.message);
    } else {
        console.log('ℹ Email connection test (expected in dev mode):', result.error);
    }
    process.exit(0);
}).catch(error => {
    console.log('ℹ Email service in development mode');
    process.exit(0);
});
EOF

    # Run the test with timeout
    timeout 10s node /tmp/test_email_service.js 2>/dev/null
    local test_result=$?

    # Clean up test file
    rm -f /tmp/test_email_service.js

    if [ $test_result -eq 0 ] || [ $test_result -eq 124 ]; then
        echo "Email service initialization test completed"
    else
        echo " Email service test had issues (may be normal in some environments)"
    fi

    echo "Email service setup completed for $ENV_TYPE environment"
    echo "Email service features:"
    echo " - Password reset emails"
    echo " - HTML + Text email templates"
    echo " - Gmail SMTP support"
    echo " - Development mode (console output)"
    echo " - Production mode (real email sending)"

    return 0
}
