# Staging Environment Configuration
# Copy this file to .env.staging and fill in your actual values
# Pre-production testing environment

# ====================================
# DATABASE CONFIGURATION (Staging DB)
# ====================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_staging_db_user
DB_PASSWORD=your_strong_staging_password
DB_NAME=todos_main_staging
DB_USERS=todos_users_staging

# ====================================
# SERVER CONFIGURATION
# ====================================
PORT=3004
NODE_ENV=staging
HTTP_HOST=0.0.0.0

# ====================================
# CORS & SECURITY (Staging URLs)
# ====================================
CORS_ORIGINS=["https://lets-todo-staging.dev2ksoftware.com"]
COOKIE_DOMAIN=.dev2ksoftware.com

# ====================================
# EMAIL SERVICE (Production-like)
# ====================================
EMAIL_PROVIDER=gmail
EMAIL_USER=staging@your-domain.com
EMAIL_PASSWORD=your-staging-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=true

# ====================================
# APPLICATION SETTINGS
# ====================================
APP_NAME=Let's Todo (Staging)
FRONTEND_URL=https://lets-todo-staging.dev2ksoftware.com

# ====================================
# STAGING ENVIRONMENT SETTINGS
# ====================================
DEBUG=false
LOG_LEVEL=warn
