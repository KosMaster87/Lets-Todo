# Feature Environment Configuration
# Copy this file to .env.feature and fill in your actual values
# Used for feature branch testing and development

# ====================================
# DATABASE CONFIGURATION
# ====================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_feature_db_user
DB_PASSWORD=your_strong_password
DB_NAME=todos_main_feat
DB_USERS=todos_users_feat

# ====================================
# SERVER CONFIGURATION
# ====================================
PORT=3003
NODE_ENV=feature
HTTP_HOST=0.0.0.0

# ====================================
# CORS & SECURITY
# ====================================
CORS_ORIGINS=["https://app-feat.your-domain.com","http://localhost:3001"]
COOKIE_DOMAIN=.dev2ksoftware.com

# ====================================
# EMAIL SERVICE (Password Reset)
# ====================================
EMAIL_PROVIDER=gmail
EMAIL_USER=your-feature-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# ====================================
# APPLICATION SETTINGS
# ====================================
APP_NAME=Let's Todo (Feature)
FRONTEND_URL=https://app.your-domain.com

# ====================================
# FEATURE ENVIRONMENT SETTINGS
# ====================================
DEBUG=true
LOG_LEVEL=debug
