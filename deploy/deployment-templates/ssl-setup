#!/bin/bash

# ============================================================================
# SSL Certificates Setup Template
# Manages Let's Encrypt SSL certificate creation and renewal
# ============================================================================

setup_ssl_cert() {
    local ENV_TYPE="$1"
    local DOMAIN="$2"
    local EMAIL="$3"
    
    echo "🔒 Setting up SSL certificates for $ENV_TYPE environment..."
    
    # Determine domains for certificate
    local cert_domains
    if [ "$ENV_TYPE" = "prod" ]; then
        cert_domains="-d $DOMAIN -d www.$DOMAIN"
    else
        cert_domains="-d $DOMAIN"
    fi
    
    # Check if certificate already exists
    local cert_path="/etc/letsencrypt/live/$DOMAIN"
    
    if [ ! -d "$cert_path" ]; then
        echo "📜 Requesting new SSL certificate..."
        
        # Request certificate
        certbot certonly \
            --webroot \
            -w /var/www/certbot \
            $cert_domains \
            --email "$EMAIL" \
            --agree-tos \
            --non-interactive
        
        if [ $? -eq 0 ]; then
            echo "✅ SSL certificate successfully created for $ENV_TYPE"
        else
            echo "❌ Failed to create SSL certificate for $ENV_TYPE"
            return 1
        fi
    else
        echo "✅ SSL certificate already exists for $ENV_TYPE"
    fi
    
    # Update nginx configuration with SSL
    update_nginx_ssl "$ENV_TYPE" "$DOMAIN"
}

update_nginx_ssl() {
    local ENV_TYPE="$1"
    local DOMAIN="$2"
    
    echo "🔧 Updating Nginx configuration with SSL for $ENV_TYPE..."
    
    # Determine paths based on environment
    local server_name
    local cert_domain
    if [ "$ENV_TYPE" = "prod" ]; then
        server_name="$DOMAIN www.$DOMAIN"
        cert_domain="$DOMAIN"
    else
        server_name="$DOMAIN"
        cert_domain="$DOMAIN"
    fi
    
    # Create SSL-enabled nginx configuration
    cat > "/etc/nginx/sites-available/lets-todo-$ENV_TYPE" << EOF
# HTTP Server - ACME Challenge + HTTPS Redirect
server {
    listen 80;
    listen [::]:80;
    server_name $server_name;

    # ACME Challenge for certbot
    location /.well-known/acme-challenge/ {
        alias /var/www/certbot/.well-known/acme-challenge/;
        try_files \$uri =404;
    }

    # All other requests redirect to HTTPS
    location / {
        return 301 https://\$host\$request_uri;
    }
}

# HTTPS Server - $ENV_TYPE API
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name $server_name;

    # SSL Configuration
    ssl_certificate     /etc/letsencrypt/live/$cert_domain/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$cert_domain/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header Referrer-Policy "no-referrer-when-downgrade";

    # Logging
    access_log  /var/log/nginx/lets-todo-api-$ENV_TYPE.log;
    error_log   /var/log/nginx/lets-todo-api-$ENV_TYPE.error.log warn;

    # API Proxy to $ENV_TYPE (Port $(get_port_for_env $ENV_TYPE))
    location ^~ /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass         http://127.0.0.1:$(get_port_for_env $ENV_TYPE);
        proxy_http_version 1.1;
        proxy_set_header   Host               \$host;
        proxy_set_header   X-Real-IP          \$remote_addr;
        proxy_set_header   X-Forwarded-For    \$proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto  \$scheme;
        proxy_set_header   Upgrade            \$http_upgrade;
        proxy_set_header   Connection         "upgrade";

        # Cookie Settings
        proxy_cookie_domain ~^\\.${cert_domain}\$ .dev2k.org;
        proxy_cookie_path ~*^/.* /;
        proxy_pass_header Set-Cookie;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # All other paths return 404
    location / {
        return 404;
    }
}
EOF
    
    # Test and reload nginx
    nginx -t
    systemctl reload nginx
    
    echo "✅ Nginx SSL configuration for $ENV_TYPE updated and reloaded"
}

get_port_for_env() {
    case "$1" in
        "prod") echo "3002" ;;
        "feat") echo "3003" ;;
        "stage") echo "3004" ;;
        *) echo "3000" ;;
    esac
}