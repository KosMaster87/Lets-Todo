#!/bin/bash

# ============================================================================
# Database Setup Template
# Uses the project's setup-dev-db.js script for automated database creation
# ============================================================================

setup_database() {
    local ENV_TYPE="$1"
    local DOMAIN="$2"
    local PORT="$3"
    local PROJECT_DIR="$4"
    
    echo "🗄️  Setting up database for $ENV_TYPE environment..."
    
    # First ensure MySQL/MariaDB user exists with proper permissions
    echo "� Setting up database user permissions..."
    
    # Create dev2k user if not exists (using sudo mysql without password)
    sudo mysql -e "
        CREATE USER IF NOT EXISTS 'dev2k'@'localhost' IDENTIFIED BY 'dev2k-passwort';
        GRANT ALL PRIVILEGES ON *.* TO 'dev2k'@'localhost';
        FLUSH PRIVILEGES;
    " 2>/dev/null
    
    if [ $? -eq 0 ]; then
        echo "✅ Database user dev2k configured successfully"
    else
        echo "⚠️  Database user might already exist or need manual setup"
    fi
    
    # Switch to project directory and run the Node.js setup script
    echo "🏗️  Running automated database setup script..."
    cd "$PROJECT_DIR"
    
    # Set the environment and run the setup script
    export NODE_ENV="$ENV_TYPE"
    
    # Run the setup-dev-db.js script which handles:
    # - Database creation (todos_users, todos_main)
    # - Table creation (users, todos)
    # - Test user creation for non-production environments
    # - Environment-specific configurations
    node scripts/setup-dev-db.js
    
    if [ $? -eq 0 ]; then
        echo "✅ Database setup completed successfully for $ENV_TYPE"
        echo "📋 Created databases:"
        echo "  - todos_users (user management)"  
        echo "  - todos_main (todo data)"
        if [ "$ENV_TYPE" != "production" ]; then
            echo "  - Test user: test@${ENV_TYPE}.local"
            echo "  - Test database: todos_user_1_${ENV_TYPE}"
        fi
    else
        echo "❌ Database setup failed for $ENV_TYPE"
        echo "💡 Troubleshooting steps:"
        echo "1. Check if MariaDB/MySQL is running: sudo systemctl status mariadb"
        echo "2. Verify environment configuration in config/env/.env.$ENV_TYPE"
        echo "3. Check database permissions for user 'dev2k'"
        return 1
    fi
    
    echo "✅ Database setup completed for $ENV_TYPE environment"
}