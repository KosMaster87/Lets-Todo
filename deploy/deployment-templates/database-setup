#!/bin/bash

# ============================================================================
# Database Setup Template
# Creates and configures database for the specified environment
# ============================================================================

setup_database() {
    local ENV_TYPE="$1"
    local DB_ROOT_PASSWORD="$2"
    local DB_USER="$3"
    local DB_PASSWORD="$4"
    
    echo "🗄️  Setting up database for $ENV_TYPE environment..."
    
    # Determine database name based on environment
    local DB_NAME="letstodo_${ENV_TYPE}"
    
    echo "📋 Database configuration:"
    echo "  - Environment: $ENV_TYPE"
    echo "  - Database: $DB_NAME"
    echo "  - User: $DB_USER"
    
    # Create database
    echo "🔨 Creating database $DB_NAME..."
    mysql -u root -p"$DB_ROOT_PASSWORD" -e "
        CREATE DATABASE IF NOT EXISTS $DB_NAME CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
    "
    
    if [ $? -eq 0 ]; then
        echo "✅ Database $DB_NAME created successfully"
    else
        echo "❌ Failed to create database $DB_NAME"
        return 1
    fi
    
    # Create/update database user
    echo "👤 Setting up database user..."
    mysql -u root -p"$DB_ROOT_PASSWORD" -e "
        CREATE USER IF NOT EXISTS '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASSWORD';
        GRANT ALL PRIVILEGES ON $DB_NAME.* TO '$DB_USER'@'localhost';
        FLUSH PRIVILEGES;
    "
    
    if [ $? -eq 0 ]; then
        echo "✅ Database user $DB_USER configured successfully"
    else
        echo "❌ Failed to configure database user"
        return 1
    fi
    
    # Test database connection
    echo "🔍 Testing database connection..."
    mysql -u "$DB_USER" -p"$DB_PASSWORD" -e "USE $DB_NAME; SELECT 1 as test;" > /dev/null 2>&1
    
    if [ $? -eq 0 ]; then
        echo "✅ Database connection test successful for $ENV_TYPE"
    else
        echo "❌ Database connection test failed for $ENV_TYPE"
        return 1
    fi
    
    # Create basic tables if needed (you can customize this)
    echo "🏗️  Creating database schema..."
    mysql -u "$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" << EOF
CREATE TABLE IF NOT EXISTS users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS todos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    completed BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS sessions (
    session_id VARCHAR(128) PRIMARY KEY,
    user_id INT NOT NULL,
    expires_at TIMESTAMP NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);
EOF
    
    if [ $? -eq 0 ]; then
        echo "✅ Database schema created successfully for $ENV_TYPE"
    else
        echo "❌ Failed to create database schema for $ENV_TYPE"
        return 1
    fi
    
    echo "✅ Database setup completed for $ENV_TYPE environment"
}