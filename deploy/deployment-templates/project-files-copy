#!/bin/bash

# ============================================================================
# Project Files Copy Template
# Copies project files to deployment directory with proper permissions
# ============================================================================

copy_project_files() {
    local ENV_TYPE="$1"
    local PROJECT_DIR="$2"
    local TARGET_DIR="$3"
    
    echo "📁 Copying project files for $ENV_TYPE environment..."
    
    # Create target directory
    mkdir -p "$TARGET_DIR"
    
    # Copy essential project files
    echo "📋 Copying core application files..."
    cp "$PROJECT_DIR/server.js" "$TARGET_DIR/"
    cp "$PROJECT_DIR/db.js" "$TARGET_DIR/"
    cp "$PROJECT_DIR/package.json" "$TARGET_DIR/"
    cp "$PROJECT_DIR/ecosystem.config.cjs" "$TARGET_DIR/"
    
    # Copy directories
    echo "📁 Copying application directories..."
    cp -r "$PROJECT_DIR/config" "$TARGET_DIR/"
    cp -r "$PROJECT_DIR/middleware" "$TARGET_DIR/"
    cp -r "$PROJECT_DIR/routing" "$TARGET_DIR/"
    cp -r "$PROJECT_DIR/scripts" "$TARGET_DIR/"
    
    # Remove example environment files (should not be deployed)
    echo "🧹 Removing example environment files..."
    find "$TARGET_DIR/config/env" -name "*.example" -type f -delete 2>/dev/null || true
    echo "✅ Example files cleaned up"
    
    # Set proper ownership and permissions
    echo "🔐 Setting proper permissions..."
    chown -R dev2k:dev2k "$TARGET_DIR"
    chmod -R 755 "$TARGET_DIR"
    chmod 644 "$TARGET_DIR"/*.js
    chmod 644 "$TARGET_DIR"/package.json
    chmod 755 "$TARGET_DIR"/ecosystem.config.cjs
    
    echo "✅ Project files copied and permissions set for $ENV_TYPE"
}