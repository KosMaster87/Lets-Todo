# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values
# SECURITY CRITICAL: Use strong passwords and secure configurations!

# ====================================
# DATABASE CONFIGURATION (Production)
# ====================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_production_db_user
DB_PASSWORD=your_ultra_secure_production_password
DB_NAME=todos_main_prod
DB_USERS=todos_users_prod

# ====================================
# SERVER CONFIGURATION
# ====================================
PORT=3002
NODE_ENV=production
HTTP_HOST=0.0.0.0

# ====================================
# CORS & SECURITY (Production URLs)
# ====================================
CORS_ORIGINS=["https://app.your-domain.com","https://www.your-domain.com"]
COOKIE_DOMAIN=.your-domain.com

# ====================================
# EMAIL SERVICE (Production SMTP)
# ====================================
EMAIL_PROVIDER=gmail
EMAIL_USER=noreply@your-domain.com
EMAIL_PASSWORD=your-production-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=true

# ====================================
# APPLICATION SETTINGS
# ====================================
APP_NAME=Let's Todo
FRONTEND_URL=https://app.your-domain.com

# ====================================
# PRODUCTION SETTINGS (Minimal Logging)
# ====================================
DEBUG=false
LOG_LEVEL=error
