{
  "name": "lets-todo-app",
  "version": "1.0.0",
  "description": "Lets Todo Frontend MPA/SPA Dev Server",
  "main": "dev-server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n SERVER,RELOAD \"nodemon dev-server.js\" \"npm run livereload\"",
    "livereload": "livereload . --wait 500 --debug --extraExts js,css,html",
    "start": "node dev-server.js",
    "watch": "nodemon dev-server.js --watch src --watch assets/styles",
    "docs": "jsdoc -c jsdoc.json"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "connect-livereload": "^0.6.1",
    "livereload": "^0.9.3",
    "nodemon": "^3.1.10"
  }
}
